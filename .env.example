# Copy to .env (never commit .env). Every key is optional; unset = feature off.

# Public origin, used for absolute og:image URLs in link previews.
NUXT_PUBLIC_SITE_URL=https://tabpet.example.com

# production | staging | development (tags analytics and error reports)
NUXT_PUBLIC_APP_ENV=production

# PostHog project API key (starts with phc_) and ingest host.
# EU cloud: https://eu.i.posthog.com
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry browser DSN.
NUXT_PUBLIC_SENTRY_DSN=

# Toss Payments (test keys start with test_). The secret key and signing secret
# stay on the server; never prefix them with NUXT_PUBLIC_.
NUXT_PUBLIC_TOSS_CLIENT_KEY=
NUXT_TOSS_SECRET_KEY=
# Any long random string, e.g. `openssl rand -base64 32`
NUXT_PURCHASE_SIGNING_SECRET=
